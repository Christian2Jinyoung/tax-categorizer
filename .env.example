# Anthropic API key used for the categorization fallback and OCR-repair vision calls.
ANTHROPIC_API_KEY=

# Models used for each Claude-backed task. Only rule-unmatched / low-confidence
# items reach Claude, so call volume should be low for personal use.
CLAUDE_MODEL_EXTRACTION=claude-sonnet-5
CLAUDE_MODEL_CATEGORIZE=claude-sonnet-5

# Path to the SQLite database file.
DATABASE_PATH=data/tax_categorizer.db

# Directory where uploaded source files are stored, per batch.
UPLOAD_DIR=data/uploads

# Which config/rulesets/*.yaml file is selected by default in the upload form.
DEFAULT_RULESET=us_self_employed_schedule_c

# OCR word-confidence (0-100) below which a line item is flagged for Claude repair.
OCR_CONFIDENCE_THRESHOLD=60

# Categorization confidence (0-1) below which a Claude categorization result is
# flagged for human review instead of being auto-accepted.
CATEGORIZATION_CONFIDENCE_THRESHOLD=0.7

# Only needed on Windows if the Tesseract-OCR binary isn't on PATH.
# Install from: https://github.com/UB-Mannheim/tesseract/wiki
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
